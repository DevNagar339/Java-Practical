import java.util.*;
interface Payable {
 void processPayment();
}

interface Printable {
 void printDetails();
}

abstract class Employee implements Payable, Printable {
    String name;
    double baseSalary;

    public Employee(String name, double baseSalary) {
     this.name = name;
     this.baseSalary = baseSalary;
    }

    abstract double calculateSalary();

    public void showInfo() {
     System.out.println("Employee Name: " + name);
    }
}

class FullTimeEmployee extends Employee {
  double bonus;

  public FullTimeEmployee(String name, double baseSalary, double bonus) {
     super(name, baseSalary);
     this.bonus = bonus;
    }

    @Override
    double calculateSalary() {
     return baseSalary + bonus;
    }

    @Override
    public void processPayment() {
     System.out.println("Processing full-time payment of: " + calculateSalary());
    }

    @Override
    public void printDetails() {
      showInfo();
      System.out.println("Type: Full-Time | Total Salary: " + calculateSalary());
    }
}

class Contractor extends Employee {
    double hourlyRate;
    int hoursWorked;

    public Contractor(String name, double hourlyRate, int hoursWorked) {
      super(name, 0.0);
      this.hourlyRate = hourlyRate;
      this.hoursWorked = hoursWorked;
    }

    @Override
    double calculateSalary() {
     return hourlyRate * hoursWorked;
    }

    @Override
    public void processPayment() {
     System.out.println("Processing contractor payment of: " + calculateSalary());
    }

    @Override
    public void printDetails() {
     showInfo();
      System.out.println("Type: Contractor | Total Salary: " + calculateSalary());
    }
}

public class Practical4 {
    public static void main(String[] args) {
     System.out.println(" Full-Time Employee");
     Employee e1 = new FullTimeEmployee("Mohan", 50000, 5000);
     e1.printDetails();
     e1.processPayment();

     System.out.println("\n Contractor ");
     Employee e2 = new Contractor("Ram", 43, 150);
     e2.printDetails();
     e2.processPayment();
    }
}
